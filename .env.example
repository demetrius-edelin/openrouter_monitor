# Example environment configuration for monitor_openrouter_models.sh
#
# Set at least one notification channel. You can set Slack, Telegram, or both.

# Slack Incoming Webhook URL for posting new OpenRouter model notifications.
# Get this from your Slack workspace (Incoming Webhooks) and paste here.
# Leave it empty to turn off Slack notifications.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Telegram bot token. Get it from @BotFather in Telegram with the /newbot command.
# Leave it empty to turn off Telegram notifications.
TELEGRAM_BOT_TOKEN=

# Telegram chat ID that receives the notifications.
# Send a message to your bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy the "chat.id" value.
TELEGRAM_CHAT_ID=
